#!/bin/bash

# Test des commandes opencode

echo "=== Test de l\'installation d\'un skill ==="
./opencode install git-workflow

echo -e "\n=== Vérification des mises à jour ==="
./opencode check-updates

echo -e "\n=== Simulation de mise à jour ==="
# On simule une version plus récente sur GitHub en modifiant temporairement le fichier local
cp skills/git-workflow/SKILL.md skills/git-workflow/SKILL.md.bak
sed -i '' 's/version: 1.0.0/version: 1.0.1/' skills/git-workflow/SKILL.md
./opencode check-updates
# Restauration du fichier original
mv skills/git-workflow/SKILL.md.bak skills/git-workflow/SKILL.md

echo -e "\n=== Test de la migration ==="
# On simule une mise à jour avec migration
cp skills/git-workflow/SKILL.md skills/git-workflow/SKILL.md.bak
sed -i '' 's/version: 1.0.0/version: 1.1.0/' skills/git-workflow/SKILL.md
./opencode update git-workflow
# Restauration du fichier original
mv skills/git-workflow/SKILL.md.bak skills/git-workflow/SKILL.md
